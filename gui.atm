;; gui.atm: reusable GUI primitives (global tasks).
;;   Object - invisible input hit-region: over + mirrored buttons.
;;   Rect  - dumb per-frame filled-rect draw.
;;   Image - dumb per-frame image draw into a rect.
;;   Text  - dumb per-frame text draw into a rect.

;; Rect: per-frame filled rectangle `rect` in `color`.
task Rect (rect, color) {
    loop on :draw {
        pico.set.pencil [ color=color, style=:fill ]
        pico.output.draw.rect(rect)
    }
}

;; Image: dumb per-frame draw of `path` into `rect`. Always draws
;; while alive; gating is the caller's job.
task Image (path, rect) {
    loop on :draw {
        pico.output.draw.image(path, rect)
    }
}

;; Text: dumb per-frame draw of `text` into `rect`, in `color`
;; (white by default). Re-sets the pencil each frame.
task Text (text, rect, color) {
    val c = color || "white"
    loop on :draw {
        pico.set.pencil [ color=c ]
        pico.output.draw.text(text, rect)
    }
}

task Object (me, tgt) {
    set me.pub = me.pub ++ [
        over   = over,
        left   = over && m.left,
        right  = over && m.right,
        middle = over && m.middle,
    ] where {
        m = pico.get.mouse('%')
        over = pico.vs.pos.rect(m, me.pub.rect)
    }

    par {
        ;; motion: track `over`, emit on/off on change
        val tags = [
            @(true)  = :o.over.on,
            @(false) = :o.over.off,
        ]
        loop e on :mouse.motion {
            val over = pico.vs.pos.rect(e, me.pub.rect)
            if over != me.pub.over {
                set me.pub.over = over
                emit @(tgt) [tag=tags@over, me=me, id=me.pub.id]
            }
        }
    } with {
        ;; button: mirror buttons + emit dn/up while over
        val tags = [
            @(:mouse.button.dn) = :o.click.dn,
            @(:mouse.button.up) = :o.click.up,
        ]
        loop e on :mouse.button until me.pub.over {
            set me.pub.left   = e.left
            set me.pub.right  = e.right
            set me.pub.middle = e.middle
            emit @(tgt) [tag=tags@(e.tag), me=me, id=me.pub.id]
        }
    }
}

task Button (id, target, style, text, rect) {
    set pub = [
        id   = id,
        rect = rect,
    ]
    pico.get.image(rect, style.image)
    spawn Object(task, target+1)
    spawn Image(style.image, rect)
    pin hl = spawn Image(style.hover, rect)
    toggle hl(false)                     ;; hidden until the pointer enters
    pin t = tasks(1)
    if text {
        spawn @t Text(text, r) where {
            r = pico.xin.rect(rect, ['%', x=0.5, y=0.5, h=0.5])
        }
    }

    ;; show highlight + tick while the pointer is over this button
    loop {
        await :o.over.on [me=task]
        pico.output.sound(style.sound)
        toggle hl(true)
        await :o.over.off [me=task]
        toggle hl(false)
    }
}
