;; gui.atm: reusable GUI primitives (global tasks).
;;   Rect  - invisible input hit-region: over + mirrored buttons.
;;   Image - dumb per-frame image draw into a rect.
;;   Text  - dumb per-frame text draw into a rect.

;; Image: dumb per-frame draw of `path` into rect `r`. Always draws
;; while alive; gating is the caller's job.
task Image (path, r) {
    loop on :draw {
        pico.output.draw.image(path, r)
    }
}

;; Text: dumb per-frame draw of `text` into rect `r`, in `color`
;; (white by default). Re-sets the pencil each frame.
task Text (text, r, color) {
    val c = color || "white"
    loop on :draw {
        pico.set.pencil [ color=c ]
        pico.output.draw.text(text, r)
    }
}

;; Rect: invisible hit-region over `r`. Tracks pointer/button state
;; on `r` and emits transitions carrying [rect=r] to `target` (a
;; task ref) or, if omitted, the direct parent.
;;
;;   r.over                  - bool, pointer is over the rect
;;   r.left/right/middle     - mirrored mouse buttons (valid while over)
;;
;; Events:  :rect.over   on enter/leave
;;          :rect.click  on a button change while over
task Rect (r, target) {
    val tgt = target || :parent

    ;; init: derive state from the current pointer
    val m = pico.get.mouse('%')
    set r.over   = pico.vs.pos.rect(m, r)
    set r.left   = r.over && m.left
    set r.right  = r.over && m.right
    set r.middle = r.over && m.middle

    par {
        ;; motion: track `over`, emit on change
        loop on :mouse.motion {
            val o = pico.vs.pos.rect(it, r)
            if o != r.over {
                set r.over = o
                emit @(tgt) :rect.over [rect=r]
            }
        }
    } with {
        ;; button: mirror the buttons while over
        loop on :mouse.button until r.over {
            set r.left   = it.left
            set r.right  = it.right
            set r.middle = it.middle
            emit @(tgt) :rect.click [rect=r]
        }
    }
}

task Fade (cur, Next, ...) {
    pico.layer.screenshot('~', nil, :snap)
    toggle cur(false)

    var p = 0.0
    spawn {
        watching until p==1 {
            loop us on :clock {
                set p = math.min(1, p + ((math.min(us, 40000) / 1000000) * 2))
            }
        }
    }

    spawn {
        watching until p==1 {
            loop on :draw {
                pico.set.scene [ clip = ['%', x=0.5, y=0.5, w=1, h=1] ]
                pico.output.draw.layer(:snap, ['%', x=0.5, y=0.5, w=1, h=1])
                pico.set.scene [ clip = ['%', x=0.5, y=0.5, w=p, h=p] ]
            }
        }
    }
    pin nxt = spawn Next(...)
    spawn {
        watching until p==1 {
            loop on :draw {
                pico.set.scene [ clip = ['%', x=0.5, y=0.5, w=1, h=1] ]
            }
        }
    }
    await(nxt)
    pico.layer.screenshot('~', nil, :snap)

    toggle cur(true)
    var q = 1.0
    spawn {
        loop on :draw {
            pico.set.scene [ clip = ['%', x=0.5, y=0.5, w=q, h=q] ]
            pico.output.draw.layer(:snap, ['%', x=0.5, y=0.5, w=1, h=1])
            pico.set.scene [ clip = ['%', x=0.5, y=0.5, w=1, h=1] ]
        }
    }
    watching until q==0 {
        loop us on :clock {
            set q = math.max(0, q - ((math.min(us, 40000) / 1000000) * 2))
        }
    }
}
