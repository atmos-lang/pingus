;; gui.atm: reusable GUI primitives (global tasks).
;;   Object - invisible input hit-region: over + mirrored buttons.
;;   Rect  - dumb per-frame filled-rect draw.
;;   Image - dumb per-frame image draw into a rect.
;;   Text  - dumb per-frame text draw into a rect.

;; Rect: per-frame filled rectangle `rect` in `color`.
task Rect (rect, color) {
    loop on :draw {
        pico.set.pencil [ color=color, style=:fill ]
        pico.output.draw.rect(rect)
    }
}

;; Image: dumb per-frame draw of `path` into rect `r`. Always draws
;; while alive; gating is the caller's job.
task Image (path, r) {
    loop on :draw {
        pico.output.draw.image(path, r)
    }
}

;; Text: dumb per-frame draw of `text` into rect `r`, in `color`
;; (white by default). Re-sets the pencil each frame.
task Text (text, r, color) {
    val c = color || "white"
    loop on :draw {
        pico.set.pencil [ color=c ]
        pico.output.draw.text(text, r)
    }
}

;; Object: invisible hit-region over `rect`. Exposes its rect + live
;; pointer/button state via `pub`, and emits transitions carrying
;; [obj=pub] to `target` (a task ref) or, if omitted, the parent.
;;
;;   pub.rect                  - the geometry (read-only)
;;   pub.over                  - bool, pointer is over the rect
;;   pub.left/right/middle     - mirrored mouse buttons (valid while over)
;;
;; Events:  :o.over.on / :o.over.off   on enter / leave
;;          :o.click.dn / :o.click.up  on press / release while over
task Object (rect, target) {
    val tgt = target || :parent

    ;; pub = the object: its rect + state, derived from the pointer
    val m = pico.get.mouse('%')
    set pub = [
        rect   = rect,
        over   = over,
        left   = over && m.left,
        right  = over && m.right,
        middle = over && m.middle,
    ] where {
        over = pico.vs.pos.rect(m, rect)
    }

    par {
        ;; motion: track `over`, emit on/off on change
        val tags = [
            @(true)  = :o.over.on,
            @(false) = :o.over.off,
        ]
        loop e on :mouse.motion {
            val o = pico.vs.pos.rect(e, rect)
            if o != pub.over {
                set pub.over = o
                emit @(tgt) [tag=tags@o, obj=pub]
            }
        }
    } with {
        ;; button: mirror buttons + emit dn/up while over
        val tags = [
            @(:mouse.button.dn) = :o.click.dn,
            @(:mouse.button.up) = :o.click.up,
        ]
        loop e on :mouse.button until pub.over {
            set pub.left   = e.left
            set pub.right  = e.right
            set pub.middle = e.middle
            emit @(tgt) [tag=tags@(e.tag), obj=pub]
        }
    }
}

task Fade (cur, Next, ...) {
    pico.layer.screenshot('~', nil, :snap)
    toggle cur(false)

    var p = 0.0
    spawn {
        watching until p==1 {
            loop us on :clock {
                set p = math.min(1, p + ((math.min(us, 40000) / 1000000) * 2))
            }
        }
    }

    spawn {
        watching until p==1 {
            loop on :draw {
                pico.set.scene [ clip = ['%', x=0.5, y=0.5, w=1, h=1] ]
                pico.output.draw.layer(:snap, ['%', x=0.5, y=0.5, w=1, h=1])
                pico.set.scene [ clip = ['%', x=0.5, y=0.5, w=p, h=p] ]
            }
        }
    }
    pin nxt = spawn Next(...)
    spawn {
        watching until p==1 {
            loop on :draw {
                pico.set.scene [ clip = ['%', x=0.5, y=0.5, w=1, h=1] ]
            }
        }
    }
    await(nxt)
    pico.layer.screenshot('~', nil, :snap)

    toggle cur(true)
    var q = 1.0
    spawn {
        loop on :draw {
            pico.set.scene [ clip = ['%', x=0.5, y=0.5, w=q, h=q] ]
            pico.output.draw.layer(:snap, ['%', x=0.5, y=0.5, w=1, h=1])
            pico.set.scene [ clip = ['%', x=0.5, y=0.5, w=1, h=1] ]
        }
    }
    watching until q==0 {
        loop us on :clock {
            set q = math.max(0, q - ((math.min(us, 40000) / 1000000) * 2))
        }
    }
}
