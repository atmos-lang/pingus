val pico = require "pico"

val BOARD    = "data/images/core/menu/blackboard.png"
val NEXT     = "data/images/core/misc/next.png"
val NEXT_HL  = "data/images/core/misc/next_hover.png"
val TICK     = "data/sounds/tick.wav"
val TITLE    = "The Journey Begins"

;; Pages: each is a story0..N drawing + its pre-wrapped text.
;; (The original word-wraps to ~570px via break_line; here the
;; lines are hand-wrapped. Full `.story` parsing is deferred.)

val PAGES = [
    [
        img = "data/images/story/story0.png",
        text = [
            "For a long time, the Pingus have lived happily in peace",
            "on the South Pole along with all the other animals.",
            "Everything was in balance and it seemed like nothing",
            "could disrupt their peace. The Pingus were happy and",
            "it seemed like this could never end.",
        ],
    ],
    [
        img = "data/images/story/story1.png",
        text = [
            "But then one day, things began to change slowly:",
            "the sky got darker and the earth got warmer. Firstly,",
            "they thought this was just a normal fluctuation in the",
            "world's climate, but things seemed to get worse and",
            "worse with every year.",
        ],
    ],
    [
        img = "data/images/story/story2.png",
        text = [
            "The snow began to melt away in a few areas and food",
            "became an issue. Other animals tried to leave the",
            "region to search for colder areas, but the Pingus knew",
            "that this wouldn't help: they knew that they had to do",
            "something about it.",
        ],
    ],
]

;; Button: the `>>>` next image; highlights on hover (tick on enter);
;; signals `:Next` on each click. Same shape as menu.atm's Button
;; (Object + Image + toggled hover), specialized: next image, no label.

val task Button (x, y) {
    val dim  = pico.get.image("%", NEXT)
    val rect = ['%', x=x, y=y, w=dim.w, h=dim.h]
    val pos  = ['%', x=x, y=y]

    ;; input + visuals (z-order: base < highlight)
    spawn Object(rect)
    spawn Image(NEXT, pos)
    pin hover = spawn Image(NEXT_HL, pos)
    toggle hover(false)                  ;; hidden until the pointer enters

    par {
        ;; show highlight + tick while the pointer is over
        loop {
            await :o.over.on
            pico.output.sound(TICK)
            toggle hover(true)
            await :o.over.off
            toggle hover(false)
        }
    } with {
        ;; signal the page loop on each inside press
        loop on :o.click.dn {
            emit @(:parent) :Next
        }
    }
}

task () {
    ;; static backdrop + title + >>> button (whole intro)
    spawn Image(BOARD, ['%', x=0.5, y=0.5, w=1, h=1])
    spawn Text(TITLE, ['%', x=0.5, y=0.13, h=0.06])
    spawn Button(0.85, 0.85)

    ;; pages: each spawns its image + a pool of text lines; advances
    ;; on :Next. Per-iteration spawns die on the next page. Escape or
    ;; the last page finishes -> returns.
    watching :key.dn [key='Escape'] {
        loop _, page in PAGES {
            spawn Image(page.img, ['%', x=0.5, y=0.39])
            pin texts = tasks(#page.text)
            loop j, line in page.text {
                spawn @texts Text(line, r) where {
                    y = 0.56 + ((j-1) * 0.04)
                    r = ['%', x=0.15, y=y, h=0.025, anchor=:W]
                }
            }
            await :Next
        }
    }
}
