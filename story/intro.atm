val pico = require "pico"

val DATA  = require "data/stories/tutorial_intro"

val BOARD  = "data/images/core/menu/blackboard.png"
val BUTTON = [
    image = "data/images/core/misc/next.png",
    hover = "data/images/core/misc/next_hover.png",
    sound = "data/sounds/tick.wav",
]

;; Title + pages loaded from the generated data file (mirrors the
;; C++ `stories/tutorial_intro.story`, pre-wrapped). Page shape:
;; { img, lines }.

task () {
    ;; static backdrop + title + >>> button (whole intro)
    spawn Image(BOARD, ['%', x=0.5, y=0.5, w=1, h=1])
    spawn Text(DATA.title, ['%', x=0.5, y=0.13, h=0.06])
    spawn Button(:Next, 1, BUTTON, nil) <- ['%', x=0.85, y=0.85]

    ;; pages: type each line letter-by-letter — finished lines stay in
    ;; a pool, the line being typed is a per-char Text re-spawned every
    ;; 50ms. An advance (>>> click or Space) mid-reveal snaps to the
    ;; full page (next one pages on); Escape or the last page returns.
    watching :key.dn [key='Escape'] {
        loop _, page in DATA.pages {
            spawn Image(page.img, ['%', x=0.5, y=0.39])
            pin ls = tasks(#page.lines)
            watching (:o.click.dn || :key.dn [key='Space']) {
                loop l, line in page.lines {
                    val r = [
                        '%', x=0.15, y=0.56+((l-1)*0.04), h=0.025, anchor=:W
                    ]
                    loop c in #line {
                        spawn Text(string.sub(line, 1, c), r)
                        await 50ms
                    }
                    spawn @ls Text(line, r)
                }
            }
            ;; snapped early -> fill the #P-#ls lines past those already pooled
            val n = #ls
            loop l in #page.lines-n {
                val i = n+l
                spawn @ls Text(page.lines@i) <- [
                    '%', x=0.15, y=0.56 + ((i-1) * 0.04), h=0.025, anchor=:W
                ]
            }
            await (:o.click.dn || :key.dn [key='Space'])
        }
    }
}
