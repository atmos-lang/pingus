val pico = require "pico"
val DIR = "data/images/core/menu/"

;; y is the layer's top edge (px) and speed its scroll (px/s).
val LAYERS = [
    [ png=DIR++"layer1.png", y=0,   speed=12  ],
    [ png=DIR++"layer2.png", y=150, speed=25  ],
    [ png=DIR++"layer3.png", y=200, speed=50  ],
    [ png=DIR++"layer4.png", y=429, speed=100 ],
    [ png=DIR++"layer5.png", y=500, speed=200 ],
]

;; Layer: scrolls one image horizontally, wrapping at the screen width.
val task Layer (l) {
    var x = 0.0
    par {
        loop us on :clock {
            set x = x + ((l.speed * us) / 1000000)
            if x >= W {
                set x = x - W
            }
        }
    } with {
        loop on :draw {
            pico.output.draw.image(l.png, ['!', x=x + (W/2), y=l.y, anchor=:N])
            pico.output.draw.image(l.png, ['!', x=x - (W/2), y=l.y, anchor=:N])
        }
    }
}

;; Button: draws a labeled box; terminates on inside-click, returns its id.
val task Button (id, text, x, y) {
    val rect = ['%', x=x, y=y, w=0.2, h=0.1]
    watching :mouse.button.dn until pico.vs.pos.rect(it, rect) {
        loop on :draw {
            pico.set.pencil [ color="white", style=:stroke ]
            pico.output.draw.rect(rect)
            pico.set.pencil [ color="white", style=:fill ]
            pico.output.draw.text(text, rect)
        }
    }
    id
}

;; Menu: parallax background + 5 buttons; returns the clicked id (no loop).
task () {
    pin layers = tasks(5)
    loop _, l in LAYERS {
        spawn @layers Layer(l)
    }
    pin buttons = tasks(5)
    spawn @buttons Button(:Story,     "Story",     0.35, 0.45)
    spawn @buttons Button(:Editor,    "Editor",    0.65, 0.45)
    spawn @buttons Button(:Levelsets, "Levelsets", 0.35, 0.6)
    spawn @buttons Button(:Options,   "Options",   0.65, 0.6)
    spawn @buttons Button(:Exit,      "Exit",      0.5,  0.75)
    await :any buttons
}
