val pico = require "pico"

;; Button: draws a labeled box; terminates on inside-click, returns its id.
val task Button (id, text, rect) {
    par :any {
        await(:mouse.button.dn until pico.vs.pos.rect(it, rect))
    } with {
        loop on :draw {
            pico.set.pencil [ color="white", style=:stroke ]
            pico.output.draw.rect(rect)
            pico.set.pencil [ color="white", style=:fill ]
            pico.output.draw.text(text, rect)
        }
    }
    id
}

;; Menu: par :any of the 5 buttons; the clicked id wins. Exit terminates.
task () {
    loop {
        val id = par :any {
            await Button(:Story,     "Story",     ['%', x=0.35, y=0.42, w=0.22, h=0.08])
        } with {
            await Button(:Editor,    "Editor",    ['%', x=0.65, y=0.42, w=0.22, h=0.08])
        } with {
            await Button(:Levelsets, "Levelsets", ['%', x=0.35, y=0.55, w=0.22, h=0.08])
        } with {
            await Button(:Options,   "Options",   ['%', x=0.65, y=0.55, w=0.22, h=0.08])
        } with {
            await Button(:Exit,      "Exit",      ['%', x=0.5,  y=0.68, w=0.22, h=0.08])
        }
        print("button clicked:", id)
        if id == :Exit {
            break
        }
    }
}
