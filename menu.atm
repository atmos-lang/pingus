val LOGO = "data/images/core/misc/logo.png"

val FOOTER = [
    infos = [
        "Pingus 0.7.6 - Copyright (C) 1998-2011 Ingo Ruhnke <grumbel@gmail.com>",
        "See the file AUTHORS for a complete list of contributors.",
        "Pingus comes with ABSOLUTELY NO WARRANTY. This is free software, and you are",
        "welcome to redistribute it under certain conditions; see the file COPYING for details.",
    ],
    help = "..:: Ctrl-g: mouse grab   ::   F10: fps counter   ::   F11: fullscreen   ::   F12: screenshot ::..",
]

val BUTTONS = [
    image = "data/images/core/menu/menuitem.png",
    hover = "data/images/core/menu/menuitem_highlight.png",
    sound = "data/sounds/tick.wav",
]

;; y is the layer's top edge (px) and speed its scroll (px/s).

val LAYERS = [
    [ png=dir++"layer1.png", y=0,   speed=12  ],
    [ png=dir++"layer2.png", y=150, speed=25  ],
    [ png=dir++"layer3.png", y=200, speed=50  ],
    [ png=dir++"layer4.png", y=429, speed=100 ],
    [ png=dir++"layer5.png", y=500, speed=200 ],
] where {
    dir = "data/images/core/menu/"
}

;; Layer: scrolls one image horizontally, wrapping at the screen width.

val task Layer (l) {
    var x = 0.0
    par {
        loop us on :clock {
            set x = x + ((l.speed * us) / 1000000)
            if x >= W {
                set x = x - W
            }
        }
    } with {
        loop on :draw {
            pico.output.draw.image(l.png, ['!', x=x+(W/2), y=l.y, anchor=:N])
            pico.output.draw.image(l.png, ['!', x=x-(W/2), y=l.y, anchor=:N])
        }
    }
}

;; Button: image + label; highlights on hover (tick on enter);
;; stays alive, signals the parent (:Button [id]) on each click.

val task Button (id, text, x, y) {
    val dim  = pico.get.image("%", BUTTONS.image)
    val rect = ['%', x=x, y=y, w=dim.w, h=dim.h]
    val pos  = ['%', x=x, y=y]
    val lbl  = ['%', x=x, y=y, h=0.05]

    ;; input + visuals (z-order: base < highlight < label)
    spawn Object(rect)
    spawn Image(BUTTONS.image, pos)
    pin hover = spawn Image(BUTTONS.hover, pos)
    spawn Text(text, lbl)
    toggle hover(false)                  ;; hidden until the pointer enters

    par {
        ;; show highlight + tick while the pointer is over
        loop {
            await :o.over until it.obj.over
            pico.output.sound(BUTTONS.sound)
            toggle hover(true)
            await :o.over until (!it.obj.over)
            toggle hover(false)
        }
    } with {
        ;; signal the menu on each inside left-press
        loop on :o.click until it.obj.left {
            emit @2 :Button [id]
        }
    }
}

;; Menu: parallax + logo + text + 5 buttons: emits :Button

val task Menu () {
    ;; parallax background
    pin layers = tasks(5)
    loop _, l in LAYERS {
        spawn @layers Layer(l)
    }

    ;; pingus logo
    spawn Image(LOGO, ['%', x=0.5, y=0.2])

    ;; footer: black bar (behind) -> help on it; info lines above
    spawn Rect(['%', x=0.5, y=1, w=1, h=0.044, anchor=:S], "black")
    spawn Text(FOOTER.help, ['%', x=0.5, y=0.978, h=0.025])
    pin infos = tasks(#FOOTER.infos)
    loop i, txt in FOOTER.infos {
        spawn @infos Text(txt, r) where {
            y = 0.8 + ((i-1) * 0.03)
            r = ['%', x=0.03, y=y, h=0.025, anchor=:W]
        }
    }

    ;; buttons
    spawn Button(:Story,     "Story",     0.35, 0.45)
    spawn Button(:Editor,    "Editor",    0.65, 0.45)
    spawn Button(:Levelsets, "Levelsets", 0.35, 0.6)
    spawn Button(:Options,   "Options",   0.65, 0.6)
    spawn Button(:Exit,      "Exit",      0.5,  0.75)
    await(false)
}

val Story = require "story"

task () {
    pin menu = spawn Menu()
    loop {
        val but = await :Button
        match but@1 {
            :Story     => await Fade(menu, Story.Intro)
            :Editor    => await Fade(menu, Blank, "Editor")
            :Levelsets => await Fade(menu, Blank, "Levelsets")
            :Options   => await Fade(menu, Blank, "Options")
            :Exit      => break()
        }
    }
}
