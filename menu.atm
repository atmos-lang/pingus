val pico = require "pico"

val FOOTER = [
    infos = [
        "Pingus 0.7.6 - Copyright (C) 1998-2011 Ingo Ruhnke <grumbel@gmail.com>",
        "See the file AUTHORS for a complete list of contributors.",
        "Pingus comes with ABSOLUTELY NO WARRANTY. This is free software, and you are",
        "welcome to redistribute it under certain conditions; see the file COPYING for details.",
    ],
    help = "..:: Ctrl-g: mouse grab   ::   F10: fps counter   ::   F11: fullscreen   ::   F12: screenshot ::..",
]

val BUTTONS = [
    image = "data/images/core/menu/menuitem.png",
    hover = "data/images/core/menu/menuitem_highlight.png",
    sound = "data/sounds/tick.wav",
]

;; y is the layer's top edge (px) and speed its scroll (px/s).

val LAYERS = [
    [ png=dir++"layer1.png", y=0,   speed=12  ],
    [ png=dir++"layer2.png", y=150, speed=25  ],
    [ png=dir++"layer3.png", y=200, speed=50  ],
    [ png=dir++"layer4.png", y=429, speed=100 ],
    [ png=dir++"layer5.png", y=500, speed=200 ],
] where {
    dir = "data/images/core/menu/"
}

;; Layer: scrolls one image horizontally, wrapping at the screen width.

val task Layer (l) {
    var x = 0.0
    par {
        loop us on :clock {
            set x = x + ((l.speed * us) / 1000000)
            if x >= W {
                set x = x - W
            }
        }
    } with {
        loop on :draw {
            pico.output.draw.image(l.png, ['!', x=x+(W/2), y=l.y, anchor=:N])
            pico.output.draw.image(l.png, ['!', x=x-(W/2), y=l.y, anchor=:N])
        }
    }
}

;; Button: image + label; highlights on hover (tick on enter);
;; terminates on inside-click, returns its id.

val task Button (id, text, x, y) {
    val dim   = pico.get.image("%", BUTTONS.image)
    val rect  = ['%', x=x, y=y, w=dim.w, h=dim.h]

    var hover = false
    spawn {
        loop {
            await :mouse.motion until pico.vs.pos.rect(it, rect)
            set hover = true
            pico.output.sound(BUTTONS.sound)
            await :mouse.motion until !pico.vs.pos.rect(it, rect)
            set hover = false
        }
    }

    spawn {
        loop on :draw {
            pico.output.draw.image(BUTTONS.image, ['%', x=x, y=y])
            if hover {
                pico.output.draw.image(BUTTONS.hover, ['%', x=x, y=y])
            }
            pico.set.pencil [ color="white" ]
            pico.output.draw.text(text, ['%', x=x, y=y, h=0.05])
        }
    }

    await :mouse.button.dn until pico.vs.pos.rect(it, rect)
    id
}

;; Menu: parallax background + 5 buttons; returns the clicked id (no loop).

task () {
    ;; parallax background
    pin layers = tasks(5)
    loop _, l in LAYERS {
        spawn @layers Layer(l)
    }

    ;; pingus logo
    spawn {
        val png = "data/images/core/misc/logo.png"
        loop on :draw {
            pico.output.draw.image(png, ['%', x=0.5, y=0.2])
        }
    }

    ;; footer text
    spawn {
        loop on :draw {
            pico.set.pencil [ color="white" ]
            loop i, txt in FOOTER.infos {
                pico.output.draw.text(txt, r) where {
                    y = 0.8 + ((i-1) * 0.03)
                    r = ['%', x=0.03, y=y, h=0.025, anchor=:W]
                }
            }
            pico.set.pencil [ color="black", style=:fill ]
            pico.output.draw.rect(['%', x=0.5, y=0.978, w=1, h=0.044])
            pico.set.pencil [ color="white" ]
            pico.output.draw.text(FOOTER.help, ['%', x=0.5, y=0.978, h=0.025])
        }
    }

    ;; buttons
    do {
        pin buttons = tasks(5)
        spawn @buttons Button(:Story,     "Story",     0.35, 0.45)
        spawn @buttons Button(:Editor,    "Editor",    0.65, 0.45)
        spawn @buttons Button(:Levelsets, "Levelsets", 0.35, 0.6)
        spawn @buttons Button(:Options,   "Options",   0.65, 0.6)
        spawn @buttons Button(:Exit,      "Exit",      0.5,  0.75)
        await :any buttons
    }
}
