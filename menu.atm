val pico = require "pico"

;; Button: draws a labeled box; terminates on inside-click, returns its id.
val task Button (id, text, x, y) {
    val rect = ['%', x=x, y=y, w=0.22, h=0.08]
    watching :mouse.button.dn until pico.vs.pos.rect(it, rect) {
        loop on :draw {
            pico.set.pencil [ color="white", style=:stroke ]
            pico.output.draw.rect(rect)
            pico.set.pencil [ color="white", style=:fill ]
            pico.output.draw.text(text, rect)
        }
    }
    id
}

;; Menu: spawns the 5 buttons and returns the clicked id (no loop).
task () {
    pin buttons = tasks(5)
    spawn @buttons Button(:Story,     "Story",     0.35, 0.42)
    spawn @buttons Button(:Editor,    "Editor",    0.65, 0.42)
    spawn @buttons Button(:Levelsets, "Levelsets", 0.35, 0.55)
    spawn @buttons Button(:Options,   "Options",   0.65, 0.55)
    spawn @buttons Button(:Exit,      "Exit",      0.5,  0.68)
    await :any buttons
}
