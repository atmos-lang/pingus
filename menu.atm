val pico = require "pico"
val DIR = "data/images/core/menu/"

;; y is the layer's vertical center; speed its scroll, both as
;; screen fractions (lower layers sit further down and move faster).
val LAYERS = [
    [ png=DIR++"layer1.png", y=0.2, speed=0.02 ],
    [ png=DIR++"layer2.png", y=0.4, speed=0.04 ],
    [ png=DIR++"layer3.png", y=0.6, speed=0.08 ],
    [ png=DIR++"layer4.png", y=0.8, speed=0.16 ],
    [ png=DIR++"layer5.png", y=0.9, speed=0.32 ],
]

;; Layer: scrolls one image horizontally, wrapping at the screen width.
val task Layer (l) {
    var x = 0.0
    par {
        loop us on :clock {
            set x = x + ((l.speed * us) / 1000000)
            if x >= 1 {
                set x = x - 1
            }
        }
    } with {
        loop on :draw {
            pico.output.draw.image(l.png, ['%', x=x + 0.5, y=l.y])
            pico.output.draw.image(l.png, ['%', x=x - 0.5, y=l.y])
        }
    }
}

;; Button: draws a labeled box; terminates on inside-click, returns its id.
val task Button (id, text, x, y) {
    val rect = ['%', x=x, y=y, w=0.22, h=0.08]
    watching :mouse.button.dn until pico.vs.pos.rect(it, rect) {
        loop on :draw {
            pico.set.pencil [ color="white", style=:stroke ]
            pico.output.draw.rect(rect)
            pico.set.pencil [ color="white", style=:fill ]
            pico.output.draw.text(text, rect)
        }
    }
    id
}

;; Menu: parallax background + 5 buttons; returns the clicked id (no loop).
task () {
    pin layers = tasks(5)
    loop _, l in LAYERS {
        spawn @layers Layer(l)
    }
    pin buttons = tasks(5)
    spawn @buttons Button(:Story,     "Story",     0.35, 0.42)
    spawn @buttons Button(:Editor,    "Editor",    0.65, 0.42)
    spawn @buttons Button(:Levelsets, "Levelsets", 0.35, 0.55)
    spawn @buttons Button(:Options,   "Options",   0.65, 0.55)
    spawn @buttons Button(:Exit,      "Exit",      0.5,  0.68)
    await :any buttons
}
