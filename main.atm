require "atmos.env.pico"
set pico = require "pico"
require "gui"

pico.set.window [ title="Pingus" ]
set W = 800
pico.set.dim ['!', w=W, h=600]

task Blank (text) {
    watching :key.dn [key='Escape'] {
        spawn Rect(['%', x=0.5, y=0.5, w=1, h=1], "black")
        spawn Text(text, ['%', x=0.5, y=0.5, h=0.1])
        await(false)
    }
}

;; Window-based reveal: freeze the old screen onto the window layer as a
;; static background, then grow a WINDOW clip so the live `world` screen
;; composites only inside the growing box (needs the pico-sdl window-clip
;; fix: the parent clip now scissors the world->window composite).
pin transition = spawn (task () {
    await :transition.restart
    loop {
        watching :transition.restart {
            do {
                pico.layer.screenshot [ mode='~', key=:transition, sup=:window ]
                defer {
                    pico.set.layer :window
                    pico.set.scene [ clip = ['%', x=0.5, y=0.5, w=1, h=1] ]
                    pico.set.layer :world
                }

                var p = 0.0
                watching until (p==1) {
                    par {
                        ;; ramp p 0 -> 1
                        loop us on :clock {
                            set p = math.min(1, p + ((math.min(us, 40000) / 1s) * 2))
                        }
                    } with {
                        ;; old screenshot = window background; window clip = the box
                        loop on :draw {
                            pico.set.layer :window
                            pico.set.scene [ clip = ['%', x=0.5, y=0.5, w=1, h=1] ]
                            pico.output.draw.layer(:transition) <- [
                                '%', x=0.5, y=0.5, w=1, h=1
                            ]
                            pico.set.scene [ clip = ['%', x=0.5, y=0.5, w=p, h=p] ]
                            pico.set.layer :world
                        }
                    }
                }
            }
            await(false)
        }
    }
}) ()
set TRANSITION = transition

val Menu = require "menu"
await Menu()
